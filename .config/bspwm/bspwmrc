#!/usr/bin/env bash

xrdb ~/.Xresources
# All three layouts loaded together; both Shifts cycle them (hold left + tap
# right = next, the reverse = previous). Loading a non-Latin layout on its own
# leaves no Latin layout for Ctrl shortcuts and sxhkd letter hotkeys to resolve
# against, so they go dead.
setxkbmap -layout us,am,ru -variant ,phonetic-alt,phonetic_winkeys \
  -option '' -option caps:escape,grp:shifts_toggle,terminate:ctrl_alt_bksp

# Push DISPLAY/XAUTHORITY into the systemd user manager so user services
# spawned at login (which started before X) get a working env on next start.
# Restart trackpad-gestures so it picks up DISPLAY — without this its bspc/rofi
# subprocesses fail silently after a reboot even though the unit is "active".
systemctl --user import-environment DISPLAY XAUTHORITY
systemctl --user restart trackpad-gestures.service

# Let initial_setup.sh handle monitor detection and configuration
$HOME/.config/bspwm/initial_setup.sh
$HOME/.config/polybar/launch.sh &
$HOME/.config/bspwm/monitor_hotplug.sh &
$HOME/.config/bspwm/battery_notifier.sh &
$HOME/.config/custom_scripts/suspender.sh &

# --timer takes <seconds> <command> <canceller>; without the third value
# xidlehook exits at startup.
xidlehook --not-when-fullscreen --not-when-audio --timer 240 "$HOME/.config/custom_scripts/lock_screen.sh" '' &
xidlehook --not-when-fullscreen --not-when-audio --timer 1800 'systemctl suspend' '' &

# Offline dictation: hold super + v, speak, release.
handy --start-hidden &

feh --bg-fill ~/death-star.jpg

bspc config top_padding             -5
bspc config border_width            1
bspc config window_gap              5

bspc config split_ratio          0.5
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc config remove_disabled_monitors true
bspc config remove_unplugged_monitors true

bspc config focus_follows_pointer true

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
